{
  "manifest_version": 3,
  "name": "Bookmark Grove",
  "version": "1.6.0",
  "description": "Kayıtlı gönderileri ve klasörleri modern, aranabilir bir görünümde gösterir.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "unlimitedStorage"],
  "action": {
    "default_title": "Open Bookmark Grove",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://pbs.twimg.com/*",
    "https://video.twimg.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/i/bookmarks*",
        "https://x.com/i/history*",
        "https://twitter.com/i/bookmarks*"
      ],
      "js": ["content/parser.js", "content/archive.js", "content/content.js"],
      "css": ["content/styles.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/inject.js"],
      "matches": ["https://x.com/*", "https://twitter.com/*"]
    }
  ]
}
